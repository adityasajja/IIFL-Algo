# ---- App ----
# dev | paper | live
APP_NAME=atr
ENV=dev
LOG_LEVEL=INFO

# ---- IIFL Capital ----
IIFL_APP_KEY=
IIFL_APP_SECRET=
IIFL_REDIRECT_URL=http://127.0.0.1:8000/login/callback
IIFL_BASE_URL=https://api.iiflcapital.com/v1
IIFL_CLIENT_ID=
IIFL_TIMEOUT=15.0
IIFL_SESSION_CACHE=.cache/iifl_session.json
IIFL_DEFAULT_PRODUCT=INTRADAY
IIFL_API_ORDER_SOURCE=atr
# SEBI requires a non-zero market-protection band on API market orders.
IIFL_MARKET_PROTECTION_PERCENT=0.5
# IIFL whitelists an IPv4 address; keep API egress on IPv4 or gated endpoints
# return EC500 "IP address not authorized for trading" over IPv6.
IIFL_FORCE_IPV4=true

# ---- Market data bridge (MQTT) ----
BRIDGE_HOST=bridge.iiflcapital.com
BRIDGE_PORT=8883

# ---- Database (optional, Postgres + TimescaleDB) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=algodb
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
DB_ECHO=false

# ---- Risk ----
MAX_GROSS_EXPOSURE=5000000
MAX_POSITION_NOTIONAL=1000000
MAX_DAILY_LOSS=50000
MAX_ORDERS_PER_DAY=500
MAX_OPEN_POSITIONS=20
ALLOW_SHORT=true
KILL_SWITCH_ENABLED=false
SQUARE_OFF_TIME=15:15

# ---- Backtest defaults ----
BT_INITIAL_CASH=1000000
BT_COMMISSION_PER_SHARE=0.005
BT_COMMISSION_PER_CONTRACT=0.85
BT_MIN_COMMISSION=1.0
BT_SLIPPAGE_BPS=5.0
BT_RISK_FREE_RATE=0.05
BT_FILL_ON_NEXT_OPEN=true
BT_EQUITY_MARGIN_RATIO=1.0

# ---- API ----
API_HOST=127.0.0.1
API_PORT=8000
API_TOKEN=change-me

# ---- Alerts (notify-only) ----
# Telegram: @BotFather -> /newbot for the token, @userinfobot for your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SMS slot (Fast2SMS key) — activates real SMS when set
FAST2SMS_API_KEY=
ALERTS_POLL_SEC=300
